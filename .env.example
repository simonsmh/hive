# ---- Vercel (apps/web) and local API testing ----
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key. Server-side only; never expose it to clients or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token that agents send as `Authorization: Bearer <token>`. Generate with: openssl rand -hex 32
HIVE_API_TOKEN=
# Password for the dashboard login page (apps/web pages). Server-side only. Login is refused while unset.
HIVE_DASHBOARD_PASSWORD=
# HMAC key for the dashboard session cookie, at least 32 characters. Generate with: openssl rand -hex 32
# Login is refused while unset or too short. Rotating it signs out every existing session.
HIVE_SESSION_SECRET=

# ---- Railway worker (apps/worker): OPTIONAL / LEGACY ----
# The okx-collector Edge Function (supabase/functions/okx-collector) replaces this worker. Do not run both.
# Session pooler (port 5432) or direct connection. Do NOT use the transaction pooler (port 6543):
# the worker relies on a session-level advisory lock, which transaction pooling does not keep.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Optional PEM CA certificate for the database endpoint. Without it TLS is accepted without CA pinning.
SUPABASE_DB_CA_CERT=
# Comma-separated base symbols. Defaults to BZ,SNDK,MU,META,NVDA,QQQ,MRNA,TSM,XAU,BTC,ETH
HIVE_SYMBOLS=
# Poll interval in seconds (5-300). Default 15.
HIVE_POLL_INTERVAL_SECONDS=15
# OKX public REST base URL. Default https://www.okx.com
OKX_BASE_URL=

# ---- Edge Functions (Supabase secrets, not this file) ----
# Set with: supabase secrets set COLLECTOR_SECRET=<hex>   (must match Vault secret okx_collector_secret)
# Set with: supabase secrets set EDGE_CRON_SECRET=<hex>   (must match Vault secret edge_cron_secret; used by jin10-poller, okx-news-poller and webhook-dispatcher)
# Optional Jin10 overrides (jin10-poller): JIN10_FLASH_URL, JIN10_APP_ID, JIN10_VERSION, JIN10_REFERER, JIN10_QUERY
# OKX_BASE_URL (above, read by okx-collector too) also sets the okx-news-poller host; default https://www.okx.com
# okx-news-poller requires a read-only OKX API key, all three together: OKX_API_KEY, OKX_API_SECRET, OKX_API_PASSPHRASE
# order-submit (demo-first order intake): HIVE_ORDER_TOKEN (bearer for callers), OKX_TRADE_API_KEY, OKX_TRADE_API_SECRET,
#   OKX_TRADE_API_PASSPHRASE (a trade-permission key, all three together). OKX_TRADE_DEMO defaults to demo; live also needs
#   OKX_TRADE_LIVE_ENABLED=true. Never commit these values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase into Edge Functions.

# ---- Migrations and schema verification (scripts/apply-migrations.sh) ----
# Target Postgres. Use a Supabase-compatible image locally, e.g. supabase/postgres:17.6.1.066
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
